# Copie este arquivo para secrets.toml e preencha as configurações necessárias.
# Nunca coloque chaves reais neste arquivo de exemplo.
GEMINI_API_KEY = ""
OPENAI_API_KEY = ""

[connections.neon]
url = "postgresql://usuario:senha@host/neondb?sslmode=require"

# Alternativamente, as chaves de API podem ficar nesta seção:
# [IA API]
# GEMINI_API_KEY = ""
# OPENAI_API_KEY = ""
